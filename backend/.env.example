# Copy to .env and fill in real values. Never commit .env.

APP_NAME="LUXURISSE PRIVATE LIMITED"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL (SQLAlchemy 2.x + psycopg)
# Encode special characters in the password (e.g. @ -> %40)
# Example: postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/luxurisse
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/luxurisse

# JWT — use a long random secret in production
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30

# CORS — frontend origins (include Vite fallback ports)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Company contact (verified — used in public settings seed)
COMPANY_EMAIL=pvtltdluxruisses@gmail.com
COMPANY_PHONE=9294744219
COMPANY_ADDRESS="Shop No-4, Telghani Naka, Kamal Super Bazar, Raipur Ganj, Raipur, Chhattisgarh - 492009"
COMPANY_MD="Lucky Nirmalkar"
COMPANY_DIRECTOR="Ajay Tarak"

# Local admin bootstrap (used by scripts/seed.py and scripts/ensure_admin.py)
ADMIN_EMAIL=pvtltdluxruisses@gmail.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
