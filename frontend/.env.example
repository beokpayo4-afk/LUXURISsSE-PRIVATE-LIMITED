# Same-origin paths (recommended for local `npm run dev` — uses Vite proxy, no CORS)
VITE_API_URL=/api/v1
VITE_API_ORIGIN=
VITE_PROXY_TARGET=https://luxurissse-private-limited-2.onrender.com

# Or talk to a local backend directly (no proxy needed if CORS allows localhost):
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_API_ORIGIN=http://localhost:8000
# VITE_PROXY_TARGET=http://localhost:8000
